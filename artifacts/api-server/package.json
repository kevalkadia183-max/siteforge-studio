{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "pnpm run test:policy && pnpm run test:gmail-approval && pnpm run test:conversation-status && pnpm run test:retell-webhook && pnpm run test:websites && pnpm run test:owner-auth && pnpm run test:provisioning && pnpm run test:rename && pnpm run test:lead-acquisition && pnpm run test:prospect && pnpm run test:prospect-frozen && pnpm run test:lead-outreach && pnpm run test:lead-outreach-db && pnpm run test:lead-outreach-backfill && pnpm run test:lead-patch-provenance && pnpm run test:lead-mutation-lock && pnpm run test:suppression-optout-bypass && pnpm run test:providers",
    "test:policy": "node --test tests/receptionist-policy.test.mjs",
    "test:gmail-approval": "node --test tests/gmail-draft-approval.test.mjs",
    "test:conversation-status": "node --test tests/receptionist-conversation-status.test.mjs",
    "test:retell-webhook": "node --test tests/retell-webhook.test.mjs",
    "test:websites": "node --test tests/websites.test.mjs",
    "test:owner-auth": "node --test tests/receptionist-owner-auth.test.mjs",
    "test:provisioning": "node --test tests/receptionist-provisioning.test.mjs",
    "test:rename": "node --test tests/website-rename.test.mjs",
    "test:lead-acquisition": "node --test tests/lead-acquisition.test.mjs",
    "test:prospect": "node --test tests/prospect-sites.test.mjs",
    "test:prospect-frozen": "node --test tests/prospect-frozen-preview.test.mjs",
    "test:lead-outreach": "node --test tests/lead-outreach.test.mjs",
    "test:lead-outreach-db": "node --test tests/lead-outreach-db.test.mjs",
    "test:lead-outreach-backfill": "node --test tests/lead-outreach-backfill.test.mjs",
    "test:lead-patch-provenance": "node --test tests/lead-patch-provenance.test.mjs",
    "test:lead-mutation-lock": "node --test tests/lead-mutation-lock-concurrency.test.mjs",
    "test:suppression-optout-bypass": "node --test tests/suppression-optout-bypass.test.mjs",
    "test:providers": "node --test tests/provider-integrations.test.mjs tests/provider-integrations-db.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.59",
    "@clerk/shared": "^4.29.2",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/siteforge-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "openai": "^7.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
